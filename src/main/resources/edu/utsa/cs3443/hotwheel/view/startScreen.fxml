<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.utsa.cs3443.hotwheel.controller.StartController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="🔥 Hot Wheel 🔥" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ff4500;"/>
    <Label text="Team Critical Hit Project" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>

    <Button text="Start Game" onAction="#onStartGameClick" prefWidth="160.0" style="-fx-font-size: 14px;"/>
    <Button text="Tutorial" onAction="#onTutorialClick" prefWidth="160.0" style="-fx-font-size: 14px;"/>
</VBox>