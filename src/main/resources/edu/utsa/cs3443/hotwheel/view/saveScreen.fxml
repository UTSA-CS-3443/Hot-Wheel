<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1280.0"
           styleClass="casino-felt-bg"
           stylesheets="@casino-theme.css"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.utsa.cs3443.hotwheel.controller.SaveController">

    <VBox alignment="CENTER" spacing="18.0" maxWidth="540.0" styleClass="casino-card-panel">
        <padding>
            <Insets top="32.0" right="36.0" bottom="32.0" left="36.0"/>
        </padding>

        <Label text="SELECT SAVE SLOT" styleClass="screen-title"/>
        <Label text="Choose a save file to load, inspect, or delete" styleClass="screen-subtitle"/>

        <HBox alignment="CENTER" spacing="14.0">
            <Button text="Slot 1" onAction="#onSelectSlot1" prefWidth="120.0" prefHeight="42.0" styleClass="slot-btn"/>
            <Button text="Slot 2" onAction="#onSelectSlot2" prefWidth="120.0" prefHeight="42.0" styleClass="slot-btn"/>
            <Button text="Slot 3" onAction="#onSelectSlot3" prefWidth="120.0" prefHeight="42.0" styleClass="slot-btn"/>
        </HBox>

        <Label fx:id="slotStatusLabel" text="Selected Slot: 1" styleClass="slot-status-label"/>

        <VBox alignment="CENTER" spacing="12.0" fillWidth="true" maxWidth="300.0">
            <Button text="Play / Load" onAction="#onPlayClick" maxWidth="Infinity" prefHeight="44.0" styleClass="casino-spin-btn"/>
            <Button text="Delete Save" onAction="#onDeleteClick" maxWidth="Infinity" prefHeight="40.0" styleClass="casino-danger-btn"/>
            <Button text="Back" onAction="#onBackClick" maxWidth="Infinity" prefHeight="40.0" styleClass="casino-secondary-btn"/>
        </VBox>
    </VBox>

</StackPane>