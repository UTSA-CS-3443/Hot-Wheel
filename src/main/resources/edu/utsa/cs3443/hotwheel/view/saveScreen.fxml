<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1280.0"
           styleClass="casino-felt-bg"
           stylesheets="@casino-theme.css"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.utsa.cs3443.hotwheel.controller.SaveController">

    <VBox alignment="CENTER" spacing="16.0" maxWidth="540.0" styleClass="casino-card-panel">
        <padding>
            <Insets top="28.0" right="36.0" bottom="28.0" left="36.0"/>
        </padding>

        <Label text="SELECT SAVE SLOT" styleClass="screen-title"/>
        <Label text="Choose a save file to play, inspect stats, or delete" styleClass="screen-subtitle"/>

        <HBox alignment="CENTER" spacing="14.0">
            <Button text="Slot 1" onAction="#onSelectSlot1" prefWidth="120.0" prefHeight="42.0" styleClass="slot-btn"/>
            <Button text="Slot 2" onAction="#onSelectSlot2" prefWidth="120.0" prefHeight="42.0" styleClass="slot-btn"/>
            <Button text="Slot 3" onAction="#onSelectSlot3" prefWidth="120.0" prefHeight="42.0" styleClass="slot-btn"/>
        </HBox>

        <Label fx:id="slotStatusLabel" text="Selected Slot: 1" styleClass="slot-status-label"/>

        <VBox fx:id="statsBox" spacing="4.0" visible="false" managed="false" styleClass="tutorial-body">
            <Label fx:id="statsSlotLabel" text="Slot Stats" styleClass="slot-status-label"/>
            <Label fx:id="statsMoneyLabel" text="Money: $0.00" styleClass="upgrade-desc"/>
            <Label fx:id="statsPrestigeLabel" text="Prestige Pts.: 0" styleClass="upgrade-desc"/>
            <Label fx:id="statsTimeLabel" text="Time Remaining: 300s" styleClass="upgrade-desc"/>
            <Label fx:id="statsWheelLabel" text="Wheel Multiplier: 1.00x" styleClass="upgrade-desc"/>
        </VBox>

        <VBox alignment="CENTER" spacing="12.0" fillWidth="true" maxWidth="300.0">
            <HBox spacing="10.0" alignment="CENTER">
                <Button text="Play" onAction="#onPlaySlotClick" maxWidth="Infinity" prefHeight="40.0"
                        HBox.hgrow="ALWAYS" styleClass="slot-btn"/>
                <Button text="Stats" onAction="#onStatsSlotClick" maxWidth="Infinity" prefHeight="40.0"
                        HBox.hgrow="ALWAYS" styleClass="casino-secondary-btn"/>
            </HBox>
            <Button text="Delete Save" onAction="#onDeleteClick" maxWidth="Infinity" prefHeight="40.0" styleClass="casino-danger-btn"/>
            <Button text="Back" onAction="#onBackClick" maxWidth="Infinity" prefHeight="40.0" styleClass="casino-secondary-btn"/>
        </VBox>
    </VBox>

</StackPane>