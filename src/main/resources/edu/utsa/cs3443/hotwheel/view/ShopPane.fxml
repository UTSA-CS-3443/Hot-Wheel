<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="shopRoot" prefWidth="360.0" minWidth="300.0" spacing="12.0"
      styleClass="shop-panel"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utsa.cs3443.hotwheel.controller.ShopController">

    <padding>
        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
    </padding>

    <Label text="HIGH ROLLER SHOP" styleClass="shop-title"/>
    <Label fx:id="statusLabel" text="Upgrades available between spins" styleClass="shop-status"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="shop-scroll">
        <content>
            <VBox fx:id="upgradeListBox" spacing="12.0">
                <padding>
                    <Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/>
                </padding>
            </VBox>
        </content>
    </ScrollPane>

</VBox>