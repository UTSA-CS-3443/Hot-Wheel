<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="380.0" prefHeight="540.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.utsa.cs3443.hotwheel.controller.GameController"
      style="-fx-background-color: #1e1e1e; -fx-padding: 20px;">

    <Label text="🔥 Hot Wheel Arena 🔥" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ff4500;"/>

    <!-- Top Stats Display -->
    <HBox alignment="CENTER" spacing="15.0">
        <Label fx:id="moneyLabel" text="Money: $100.00" style="-fx-text-fill: white; -fx-font-size: 13px;"/>
        <Label fx:id="timerLabel" text="Time Left: 300s" style="-fx-text-fill: white; -fx-font-size: 13px;"/>
        <Label fx:id="prestigeLabel" text="Prestige: 0" style="-fx-text-fill: white; -fx-font-size: 13px;"/>
    </HBox>

    <!-- Pointer Indicator at the Top -->
    <Label text="▼" style="-fx-text-fill: #ffcc00; -fx-font-size: 22px; -fx-font-weight: bold;"/>

    <!-- Visual Wheel Container -->
    <StackPane fx:id="wheelContainer" prefWidth="220.0" prefHeight="220.0" style="-fx-alignment: CENTER;"/>

    <Label fx:id="actionFeedLabel" text="Spin the wheel to start earning!" style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;" textAlignment="CENTER"/>

    <!-- Action Buttons -->
    <Button fx:id="spinButton" text="SPIN WHEEL!" onAction="#onSpinClick" prefWidth="200.0" style="-fx-base: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;"/>
    <Button text="Back to Saves" onAction="#onBackToSaveClick" prefWidth="200.0" style="-fx-base: #444444; -fx-text-fill: white;"/>

</VBox>